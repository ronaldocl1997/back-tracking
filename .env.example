NODE_ENV=development
PORT=3000
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/back_tracking?schema=public"

# Genera uno con: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="cambia-esto-por-un-secreto-de-al-menos-32-caracteres"
JWT_ISSUER=back-tracking
JWT_AUDIENCE=back-tracking-clients
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
REFRESH_TOKEN_ABSOLUTE_TTL=90d

# Detección de visitas
VISIT_DWELL_SECONDS=120
VISIT_MAX_ACCURACY_M=50
PING_MAX_FUTURE_SKEW_SECONDS=120
# Días que se guarda el trazo GPS (0 = para siempre). Visitas y recorridos no se borran.
PING_RETENTION_DAYS=0

# Orígenes del navegador permitidos (CORS), separados por coma; '*' = cualquier puerto.
# En producción: CORS_ORIGINS=https://panel.tuempresa.com
CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*

# Documentación en /docs (true/false)
SWAGGER_ENABLED=true

# Límite de peticiones por minuto y por IP
THROTTLE_LIMIT=120
THROTTLE_AUTH_LIMIT=5

# Primer administrador (npx prisma db seed)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD="cambia-esta-contraseña"
